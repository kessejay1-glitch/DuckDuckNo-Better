---
import Logo from "../assets/logo-optimized.svg";
import Footer from "../components/Footer.astro";
import Searchbox from "../components/SearchBox.astro";
import "../css/index.css";
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<meta name="color-scheme" content="dark" />
		<title>Duck Duck No Better — Search</title>
	</head>
	<body>
		<main class="landing-container">
			<!-- Hero Branding -->
			<div class="hero-section">
				<div class="logo-wrapper">
					<div class="logo-glow" aria-hidden="true"></div>
					<div class="logo-container">
						<Logo />
					</div>
				</div>
				<h1 class="title">Duck Duck No Better</h1>
				<p class="subtitle">Fast, private, and direct web search.</p>
			</div>

			<!-- Search Bar Section -->
			<div class="search-wrapper">
				<Searchbox class="search" />
			</div>
		</main>

		<Footer github="index.astro" />
	</body>
</html>

<style>
	:root {
		--bg-primary: #14141b;
		--bg-surface: #1c1c27;
		--border-subtle: #2d2d3f;
		--text-primary: #f3f4f6;
		--text-secondary: #9ca3af;
		--accent: #6366f1;
		--accent-glow: rgba(99, 102, 241, 0.25);
	}

	:global(*) {
		box-sizing: border-box;
		-webkit-tap-highlight-color: transparent;
	}

	:global(body) {
		margin: 0;
		background-color: var(--bg-primary);
		color: var(--text-primary);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		overflow-x: hidden;
	}

	.landing-container {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 2rem 1.25rem;
		width: 100%;
		max-width: 600px;
		margin: 0 auto;
		animation: fadeIn 0.4s ease-out;
	}

	/* Hero Section */
	.hero-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		margin-bottom: 2rem;
		width: 100%;
	}

	.logo-wrapper {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.25rem;
	}

	.logo-glow {
		position: absolute;
		width: 4rem;
		height: 4rem;
		background: var(--accent);
		filter: blur(28px);
		opacity: 0.5;
		border-radius: 50%;
		z-index: 0;
	}

	.logo-container {
		position: relative;
		width: 4.5rem;
		height: 4.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1;
		transition: transform 0.2s ease;
	}

	.logo-container:hover {
		transform: scale(1.06);
	}

	.title {
		margin: 0 0 0.5rem;
		font-size: clamp(1.75rem, 5vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		background: linear-gradient(135deg, #ffffff 30%, #a5b4fc 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.subtitle {
		margin: 0;
		font-size: 0.95rem;
		color: var(--text-secondary);
		font-weight: 400;
	}

	/* Search Bar Wrapper */
	.search-wrapper {
		width: 100%;
		background: var(--bg-surface);
		border: 1px solid var(--border-subtle);
		border-radius: 14px;
		padding: 0.5rem;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.search-wrapper:focus-within {
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-glow), 0 8px 32px rgba(0, 0, 0, 0.3);
	}

	/* Ensure internal searchbox elements scale fluidly */
	.search-wrapper :global(input),
	.search-wrapper :global(form) {
		width: 100%;
		background: transparent;
		border: none;
		outline: none;
		color: var(--text-primary);
		font-size: 1rem;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
